<ResourceDictionary x:Class="Nina.FieldKit.Plugin.SequenceTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Nina.FieldKit.Plugin"
    xmlns:seq="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">
    <DataTemplate DataType="{x:Type local:AutofocusAboveHfr}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Maximum HFR" VerticalAlignment="Center" />
                        <TextBox Width="70" Margin="8,0" Text="{Binding MaximumHfr, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"
                        Text="Refocus above the limit; fail if still too high."
                        ToolTip="Uses the latest image or autofocus fit HFR. Missing HFR runs autofocus. Requires Star HFR mode." />
                    <Border Margin="0,8,0,0" Padding="6" BorderThickness="1" BorderBrush="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
        </seq:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:AutofocusAboveHfrTrigger}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Maximum HFR" VerticalAlignment="Center" />
                    <TextBox MinWidth="40" Margin="5,0,0,0" VerticalAlignment="Center"
                        VerticalContentAlignment="Center" TextAlignment="Right"
                        Text="{Binding MaximumHfr, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                        ToolTip="Refocus above this absolute HFR limit. Uses the latest image or autofocus fit; requires Star HFR mode." />
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
            <seq:SequenceBlockView.SequenceItemProgressContent>
                <TextBlock VerticalAlignment="Center" Text="{Binding LastResult}"
                    ToolTip="Autofocus runs before the next light exposure. A result still above the limit fails the trigger." />
            </seq:SequenceBlockView.SequenceItemProgressContent>
        </seq:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:MountHealthCheck}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="6">
                    <TextBlock Text="Checks reported mount state only. No equipment commands." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Text="Samples (1–60, one second apart)" VerticalAlignment="Center" />
                        <TextBox Width="55" Margin="8,0" Text="{Binding SampleCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <CheckBox Content="Require tracking (only where imaging is expected)" IsChecked="{Binding RequireTracking}" />
                    <CheckBox Content="Require unparked" IsChecked="{Binding RequireUnparked}" />
                    <CheckBox Content="Require no reported slew" IsChecked="{Binding RequireStationary}" />
                    <CheckBox Content="Require confirmed device response (currently returns unknown)" IsChecked="{Binding RequireConfirmedResponse}" />
                    <TextBlock Margin="0,6" Text="{Binding LastResult}" TextWrapping="Wrap" />
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
        </seq:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:CaptureEquipmentSnapshot}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="6">
                    <TextBlock Text="Writes the mount's cached state to the NINA session log." TextWrapping="Wrap" />
                    <TextBlock Margin="0,6" Text="{Binding LastResult}" TextWrapping="Wrap" />
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
        </seq:SequenceBlockView>
    </DataTemplate>
</ResourceDictionary>
