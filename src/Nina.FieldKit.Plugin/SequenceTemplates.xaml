<ResourceDictionary x:Class="Nina.FieldKit.Plugin.SequenceTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Nina.FieldKit.Plugin"
    xmlns:clouds="clr-namespace:Nina.FieldKit.Plugin.Clouds"
    xmlns:cloudModel="clr-namespace:Nina.FieldKit.Core.Clouds;assembly=Nina.FieldKit.Core"
    xmlns:containers="clr-namespace:NINA.Sequencer.Container;assembly=NINA.Sequencer"
    xmlns:seq="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">
    <DataTemplate DataType="{x:Type local:TwilightFlatFiltersContainer}">
        <seq:SequenceContainerView>
            <seq:SequenceContainerView.Resources>
                <DataTemplate DataType="{x:Type containers:SequenceContainer}"><seq:SequenceContainerView /></DataTemplate>
                <DataTemplate DataType="{x:Type containers:ParallelContainer}"><seq:SequenceContainerView /></DataTemplate>
            </seq:SequenceContainerView.Resources>
            <seq:SequenceContainerView.SequenceContainerContent>
                <StackPanel Margin="8,4" TextElement.Foreground="{DynamicResource PrimaryBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Margin="0,0,10,0" Command="{Binding SetupCommand}" IsEnabled="{Binding CanEditFilters}">
                            <TextBlock Text="Setup…" Margin="10,5" Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding NightSummary}" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.8" />
                        <TextBlock Text="{Binding FilterSummary}" ToolTip="{Binding FilterSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Margin="0,5,0,0" Text="{Binding FilterStatus}" ToolTip="{Binding FilterStatus}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding LastResult}" ToolTip="{Binding LastResult}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </seq:SequenceContainerView.SequenceContainerContent>
        </seq:SequenceContainerView>
    </DataTemplate>
    <!-- A self-contained native container owns its child list in both TreeView and embedded ItemsControl hosts. -->
    <DataTemplate DataType="{x:Type local:SkyFlatRotationsContainer}">
        <seq:SequenceContainerView>
            <seq:SequenceContainerView.Resources>
                <!-- Native generic sets need self-contained children when hosted inside an ItemsControl too. -->
                <DataTemplate DataType="{x:Type containers:SequenceContainer}">
                    <seq:SequenceContainerView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type containers:ParallelContainer}">
                    <seq:SequenceContainerView />
                </DataTemplate>
            </seq:SequenceContainerView.Resources>
            <seq:SequenceContainerView.SequenceContainerContent>
                <StackPanel Margin="8,4">
                    <WrapPanel>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding NightOffset}" MinWidth="150" Margin="0,0,10,0"
                            ToolTip="Observing nights run noon to noon in the computer's local time. Use Previous night for flats after noon.">
                            <ComboBoxItem Content="Current night"><ComboBoxItem.Tag><sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">0</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="Previous night"><ComboBoxItem.Tag><sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">-1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Tolerance °" VerticalAlignment="Center" />
                        <TextBox Width="55" Margin="5,0,10,0" Text="{Binding ToleranceDegrees, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                            ToolTip="Group positions this close together and require the rotator to arrive within this tolerance. Default 0.1°; 0° and 180° remain distinct." />
                        <TextBlock Text="Move timeout s" VerticalAlignment="Center" />
                        <TextBox Width="55" Margin="5,0,10,0" Text="{Binding MoveTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <Button Command="{Binding PreviewCommand}"><TextBlock Text="Show rotations" Margin="8,3" Foreground="{DynamicResource ButtonForegroundBrush}" /></Button>
                    </WrapPanel>
                    <TextBlock Margin="0,5,0,0" Text="{Binding LastResult}" TextWrapping="Wrap" />
                </StackPanel>
            </seq:SequenceContainerView.SequenceContainerContent>
        </seq:SequenceContainerView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:SaveAutofocusReference}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="After startup autofocus" VerticalAlignment="Center"
                        ToolTip="Save the latest successful autofocus for this NINA profile, focuser and filter. Place immediately after Run Autofocus, with its filter selected." />
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
            <seq:SequenceBlockView.SequenceItemProgressContent>
                <TextBlock Text="{Binding LastResult}" VerticalAlignment="Center" MaxWidth="240"
                    TextTrimming="CharacterEllipsis" ToolTip="{Binding LastResult}" />
            </seq:SequenceBlockView.SequenceItemProgressContent>
        </seq:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:RestoreAutofocusReference}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Steps / °C" VerticalAlignment="Center" />
                    <TextBox MinWidth="60" Margin="5,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                        Text="{Binding StepsPerDegree, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                        ToolTip="Measured signed slope. Restore saved position + slope × (current temperature − saved temperature), then run autofocus. A negative slope increases position as temperature falls." />
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
            <seq:SequenceBlockView.SequenceItemProgressContent>
                <TextBlock Text="{Binding LastResult}" VerticalAlignment="Center" MaxWidth="240"
                    TextTrimming="CharacterEllipsis" ToolTip="{Binding LastResult}" />
            </seq:SequenceBlockView.SequenceItemProgressContent>
        </seq:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:TemperatureCompensationTrigger}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Steps / °C" VerticalAlignment="Center" />
                    <TextBox MinWidth="60" Margin="5,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                        Text="{Binding StepsPerDegree, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                        ToolTip="Enter your measured signed slope. Positive increases position as temperature rises; negative decreases it. Uses the focuser temperature and NINA's relative compensation baseline." />
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
            <seq:SequenceBlockView.SequenceItemProgressContent>
                <TextBlock Text="{Binding LastResult}" VerticalAlignment="Center" MaxWidth="240"
                    TextTrimming="CharacterEllipsis" ToolTip="{Binding LastResult}" />
            </seq:SequenceBlockView.SequenceItemProgressContent>
        </seq:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type clouds:CloudGuardTrigger}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="135" SelectedValuePath="Tag" SelectedValue="{Binding Response}" IsEnabled="{Binding CanChangeResponse}"
                        ToolTip="Park and retry: Field Kit owns recovery. Report unsafe: Field Kit Safety Monitor signals your existing unsafe sequence. Choose before starting the sequence.">
                        <ComboBoxItem Content="Park and retry" Tag="{x:Static cloudModel:CloudResponse.ParkAndRetry}" />
                        <ComboBoxItem Content="Report unsafe" Tag="{x:Static cloudModel:CloudResponse.ReportUnsafe}" />
                    </ComboBox>
                    <Button Margin="6,0,0,0" Command="{Binding SetupCommand}" ToolTip="Cloud detection thresholds, retry timer and morning cutoff">
                        <TextBlock Text="Setup" Margin="8,3" Foreground="{DynamicResource ButtonForegroundBrush}" />
                    </Button>
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
            <seq:SequenceBlockView.SequenceItemProgressContent>
                <TextBlock Text="{Binding LastResult}" MaxWidth="280" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastResult}" />
            </seq:SequenceBlockView.SequenceItemProgressContent>
        </seq:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:SlewToSkyFlatPoint}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="75° altitude, opposite Sun" VerticalAlignment="Center"
                        ToolTip="Calculated at execution using your NINA profile location. Requires an unparked mount; enables tracking after the slew." />
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
            <seq:SequenceBlockView.SequenceItemProgressContent>
                <TextBlock Text="{Binding LastResult}" VerticalAlignment="Center" />
            </seq:SequenceBlockView.SequenceItemProgressContent>
        </seq:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:AutofocusAboveHfr}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Maximum HFR" VerticalAlignment="Center" />
                        <TextBox Width="70" Margin="8,0" Text="{Binding MaximumHfr, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"
                        Text="Refocus above the limit; fail if still too high."
                        ToolTip="Uses the latest image or autofocus fit HFR. Missing HFR runs autofocus. Requires Star HFR mode." />
                    <Border Margin="0,8,0,0" Padding="6" BorderThickness="1" BorderBrush="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
        </seq:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:AutofocusAboveHfrTrigger}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Maximum HFR" VerticalAlignment="Center" />
                    <TextBox MinWidth="40" Margin="5,0,0,0" VerticalAlignment="Center"
                        VerticalContentAlignment="Center" TextAlignment="Right"
                        Text="{Binding MaximumHfr, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                        ToolTip="Refocus above this absolute HFR limit. Uses the latest image or autofocus fit; requires Star HFR mode." />
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
            <seq:SequenceBlockView.SequenceItemProgressContent>
                <TextBlock VerticalAlignment="Center" Text="{Binding LastResult}"
                    ToolTip="Autofocus runs before the next light exposure. A result still above the limit fails the trigger." />
            </seq:SequenceBlockView.SequenceItemProgressContent>
        </seq:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:MountHealthCheck}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="6">
                    <TextBlock Text="Checks reported mount state only. No equipment commands." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Text="Samples (1–60, one second apart)" VerticalAlignment="Center" />
                        <TextBox Width="55" Margin="8,0" Text="{Binding SampleCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <CheckBox Content="Require tracking (only where imaging is expected)" IsChecked="{Binding RequireTracking}" />
                    <CheckBox Content="Require unparked" IsChecked="{Binding RequireUnparked}" />
                    <CheckBox Content="Require no reported slew" IsChecked="{Binding RequireStationary}" />
                    <CheckBox Content="Require confirmed device response (currently returns unknown)" IsChecked="{Binding RequireConfirmedResponse}" />
                    <TextBlock Margin="0,6" Text="{Binding LastResult}" TextWrapping="Wrap" />
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
        </seq:SequenceBlockView>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:CaptureEquipmentSnapshot}">
        <seq:SequenceBlockView>
            <seq:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="6">
                    <TextBlock Text="Writes the mount's cached state to the NINA session log." TextWrapping="Wrap" />
                    <TextBlock Margin="0,6" Text="{Binding LastResult}" TextWrapping="Wrap" />
                </StackPanel>
            </seq:SequenceBlockView.SequenceItemContent>
        </seq:SequenceBlockView>
    </DataTemplate>
</ResourceDictionary>
