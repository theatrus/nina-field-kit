<Window x:Class="Nina.FieldKit.Plugin.TwilightFlatsSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Field Kit — Twilight flats setup" Width="660" Height="660" MinWidth="560" MinHeight="560"
    WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
    Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource PrimaryBrush}" FontSize="14">
    <DockPanel Margin="20" Background="{DynamicResource BackgroundBrush}" TextElement.Foreground="{DynamicResource PrimaryBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Twilight flats setup" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.8"
                Text="Select filters and arrange them in your light-to-dark order. All captured rotations finish on one filter before the next." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Notice" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Click="CancelClick" IsCancel="True" Margin="0,0,8,0">
                    <TextBlock Text="Cancel" Margin="12,7" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
                <Button Click="ApplyClick" IsDefault="True">
                    <TextBlock Text="Apply" Margin="12,7" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
            </StackPanel>
        </StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <TextBlock Text="ROTATIONS" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="PreviewClick" Margin="10,0,0,0">
                        <TextBlock Text="Show rotations" Margin="10,6" Foreground="{DynamicResource ButtonForegroundBrush}" />
                    </Button>
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding NightOffset, Mode=TwoWay}"
                        ToolTip="An observing night runs noon to noon in the computer's local time.">
                        <ComboBoxItem Content="Current night"><ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                        <ComboBoxItem Content="Previous night"><ComboBoxItem.Tag><sys:Int32>-1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                    </ComboBox>
                </DockPanel>
                <TextBlock x:Name="RotationPreview" Margin="0,8,0,0" TextWrapping="Wrap" />
                <Expander Header="Movement settings" Margin="0,10,0,0">
                    <Grid Margin="8,8,8,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Rotation tolerance (°)" VerticalAlignment="Center"
                            ToolTip="Group captured angles this close together; also used to confirm arrival." />
                        <TextBox Grid.Column="1" Margin="10,0,0,8" Text="{Binding ToleranceDegrees, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Text="Move timeout (seconds)" VerticalAlignment="Center"
                            ToolTip="Deadline for each filter change and each rotator move." />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Text="{Binding MoveTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Expander>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="FILTER ORDER" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Use" Opacity="0.8" />
                    <TextBlock Grid.Column="1" Text="Filter" Opacity="0.8" />
                    <TextBlock Grid.Column="2" Text="Order" Opacity="0.8" HorizontalAlignment="Center" />
                </Grid>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button HorizontalAlignment="Left" Command="{Binding RefreshCommand}"
                    ToolTip="Keep matching filters in your order; add new profile filters unchecked.">
                    <TextBlock Text="Refresh profile filters" Margin="10,6" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Button>
            </StackPanel>
            <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SecondaryBackgroundBrush}" Padding="8,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl Tag="FlatFilterOrder" ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3" MinHeight="30">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                                    <CheckBox Width="65" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}"
                                        IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="1" Tag="FilterName" Text="{Binding Name}" ToolTip="{Binding Name}"
                                        Foreground="{DynamicResource PrimaryBrush}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Margin="3,0" ToolTip="Move filter up" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <TextBlock Text="↑" Margin="6,3" Foreground="{DynamicResource ButtonForegroundBrush}" />
                                    </Button>
                                    <Button Grid.Column="3" Margin="3,0" ToolTip="Move filter down" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <TextBlock Text="↓" Margin="6,3" Foreground="{DynamicResource ButtonForegroundBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
