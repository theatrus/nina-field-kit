<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Nina.FieldKit.Plugin</AssemblyName>
    <AssemblyTitle>Field Kit</AssemblyTitle>
    <Description>Combines Alpaca and local ASCOM safety sources with optional Cloud guard into one NINA safety result. Cloud guard watches star counts, guiding and solve failures, then parks and retries or signals an existing unsafe sequence. Twilight flats by filter and rotation runs native Twilight Sky Flats at every captured mechanical angle in your chosen filter order, with a compact sequence view and separate setup dialog. Also includes background safety polling, retries, live setup, diagnostics, Slew to sky-flat point, AF above HFR, temperature compensation after light frames, and temperature-adjusted autofocus reference save/restore.</Description>
    <ApplicationIcon>Assets/field-kit.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/field-kit.svg" />
    <Resource Include="Assets/field-kit.png" />
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" />
    <ProjectReference Include="../Nina.FieldKit.Core/Nina.FieldKit.Core.csproj" />
  </ItemGroup>
</Project>
