<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Nina.FieldKit.Plugin</AssemblyName>
    <AssemblyTitle>Field Kit</AssemblyTitle>
    <Description>Combines multiple Alpaca safety sources into one NINA safety result, with background polling, configurable retries, live setup, and clear diagnostics. Includes Autofocus Above HFR: a trigger that runs autofocus before the next light exposure when the latest HFR exceeds your chosen limit and rejects autofocus fits that remain above it.</Description>
    <ApplicationIcon>Assets/field-kit.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/field-kit.svg" />
    <Resource Include="Assets/field-kit.png" />
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" />
    <ProjectReference Include="../Nina.FieldKit.Core/Nina.FieldKit.Core.csproj" />
  </ItemGroup>
</Project>
