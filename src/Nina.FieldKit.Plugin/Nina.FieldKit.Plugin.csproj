<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Nina.FieldKit.Plugin</AssemblyName>
    <AssemblyTitle>Field Kit</AssemblyTitle>
    <Description>Combines Alpaca and local ASCOM safety sources with optional Cloud guard into one NINA safety result. Cloud guard watches star counts, guiding and solve failures, then parks and retries or signals an existing unsafe sequence. Includes background safety polling, configurable retries, live setup, diagnostics, Slew to sky-flat point (75 degrees altitude opposite the Sun), AF above HFR, temperature compensation after light frames, and temperature-adjusted autofocus reference save/restore for nightly startup.</Description>
    <ApplicationIcon>Assets/field-kit.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/field-kit.svg" />
    <Resource Include="Assets/field-kit.png" />
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" />
    <ProjectReference Include="../Nina.FieldKit.Core/Nina.FieldKit.Core.csproj" />
  </ItemGroup>
</Project>
