<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Nina.FieldKit.Plugin</AssemblyName>
    <AssemblyTitle>NINA Field Kit</AssemblyTitle>
    <Description>Safety monitoring and equipment checks for your observing session.</Description>
    <ApplicationIcon>Assets/field-kit.ico</ApplicationIcon>
    <Version>0.1.0.3</Version>
    <AssemblyVersion>0.1.0.3</AssemblyVersion>
    <FileVersion>0.1.0.3</FileVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/field-kit.svg" />
    <Resource Include="Assets/field-kit.png" />
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" />
    <ProjectReference Include="../Nina.FieldKit.Core/Nina.FieldKit.Core.csproj" />
  </ItemGroup>
</Project>
